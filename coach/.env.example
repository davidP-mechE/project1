# Postgres. pgvector is optional: without it, similarity is computed in the app.
DATABASE_URL=postgresql://coach:coach@localhost:5432/coach
TEST_DATABASE_URL=postgresql://coach:coach@localhost:5432/coach_test

# Language model. Without a key the app runs the offline engine (rule-based, for
# development, demos and the deterministic eval suite). Never ship that to users.
ANTHROPIC_API_KEY=
# Pinned model versions: the strongest model for the analyst, critic and coach voice;
# a small, fast one for the safety pre-screen and extraction (spec: "Model strategy").
COACH_MODEL_MAIN=claude-opus-5-5
COACH_MODEL_FAST=claude-haiku-5-5

# Signs the anonymous device cookie (prototype identity until a managed auth provider is chosen).
COACH_COOKIE_SECRET=change-me-to-a-long-random-string
