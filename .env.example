# ─── Core ───────────────────────────────────────────────────────────────
# Public URL of the app (used in emails and auth callbacks)
APP_URL=http://localhost:3000

# PostgreSQL (with the pgvector extension). docker compose provides this.
DATABASE_URL=postgresql://coursebook:coursebook@localhost:5432/coursebook
# Separate database used by automated tests (it gets wiped).
TEST_DATABASE_URL=postgresql://coursebook:coursebook@localhost:5432/coursebook_test

# Redis (job queue for the background worker)
REDIS_URL=redis://localhost:6379
# Background worker: books processed at once, and OCR threads per worker.
# Each OCR thread uses ~1 CPU core and ~150 MB RAM.
WORKER_CONCURRENCY=1
OCR_WORKERS=2

# ─── Auth ───────────────────────────────────────────────────────────────
# Long random string. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Optional: Google sign-in. Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Two-factor login is required for tutoring-program staff. Set to "off" only for local
# development without an authenticator app (never in production).
STAFF_TWO_FACTOR=required

# The site owner: the account with this (verified) email gets the "owner" role when the server
# starts and at each login, and is the only one who can open /studio (everyone else gets a 404).
# Anyone else who had the owner role is set back to student. Leave blank for no owner.
OWNER_EMAIL=

# Desmos API key (request one at desmos.com/api and accept its terms; check them for commercial use).
# Used for the calculator panel, Desmos check blocks and graphs on questions. Only the graph itself is
# sent to Desmos. Without a key, those places show a short note and a link to desmos.com/calculator.
DESMOS_API_KEY=

# Which copy this is: production, staging or development. A staging copy refuses to
# start if DATABASE_URL is the production database (set PRODUCTION_DATABASE_URL to check).
APP_ENV=development
PRODUCTION_DATABASE_URL=

# Nightly database backups by the worker (needs pg_dump: install postgresql-client),
# kept in file storage under backups/ for BACKUP_RETENTION_DAYS days.
BACKUPS_ENABLED=false
BACKUP_RETENTION_DAYS=30

# ─── Email ──────────────────────────────────────────────────────────────
# Email. Either set RESEND_API_KEY (Resend's HTTP API: works on hosts that block SMTP ports)
# or the SMTP settings below. With neither, emails are printed to the server console (development only).
RESEND_API_KEY=
# Leave SMTP_HOST blank to print emails to the server console instead of sending.
# docker compose runs Mailpit: SMTP on 1025, inbox UI at http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Coursebook <hello@coursebook.site>"

# ─── File storage ───────────────────────────────────────────────────────
# "local" (files in ./storage, dev only) or "s3" (AWS S3 or Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Used when STORAGE_DRIVER=s3. For R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Claude API ─────────────────────────────────────────────────────────
# Get a key at console.anthropic.com → API Keys. Never commit it or paste it anywhere public.
ANTHROPIC_API_KEY=
# Which models do which job (defaults shown). Prices: see src/lib/ai/models.ts
CLAUDE_MODEL_GENERATION=claude-sonnet-5-5
CLAUDE_MODEL_FALLBACK=claude-opus-5-5
# Simple jobs go to the small model: transcribing equation-heavy pages / picture slides, and flashcards
CLAUDE_MODEL_VISION=claude-haiku-5-5
CLAUDE_MODEL_FLASHCARDS=claude-haiku-5-5
CLAUDE_EFFORT_FLASHCARDS=low
# low | medium | high: how hard Claude thinks while writing a lesson (higher = better, slower, pricier)
CLAUDE_EFFORT_GENERATION=medium
# Whole-course generation through the Message Batches API: half price, lessons arrive together,
# usually within an hour (at most 24h). Set to false to write lessons one by one (faster, twice the price).
CLAUDE_BATCH_GENERATION=true
# Grading students' written answers (short answer / step-by-step). ~1-2 cents per answer.
CLAUDE_MODEL_GRADING=claude-opus-5-5
CLAUDE_EFFORT_GRADING=low
# Written answers one student can have graded per hour
GRADING_PER_HOUR=60
# "Ask the book" tutor: model, effort, and questions per student per hour (~2-5 cents each)
CLAUDE_MODEL_TUTOR=claude-opus-5-5
CLAUDE_EFFORT_TUTOR=low
TUTOR_PER_HOUR=30

# ─── Embeddings (the tutor's meaning search; runs in the worker) ────────
# The worker downloads a small model (~34 MB) from huggingface.co on first start.
# Where to keep it (default ~/.cache/coursebook/models). Keep it OUTSIDE the project
# folder, or `npm run dev` keeps reloading.
EMBEDDINGS_CACHE_DIR=
# Lessons written at the same time by the worker
GENERATION_CONCURRENCY=3
# Development only: write free placeholder "demo" lessons instead of calling Claude
FAKE_CLAUDE=false

# ─── Plan limits (optional; defaults shown) ────────────────────────────
# Monthly allowances per plan (FREE / PRO). Students see them in Settings → Plan and usage.
# FREE_MONTHLY_AI_USD=5
# FREE_PAGES_PER_MONTH=500
# FREE_MAX_BOOKS=10
# FREE_STORAGE_GB=2
# PRO_MONTHLY_AI_USD=50
# PRO_PAGES_PER_MONTH=5000
# PRO_MAX_BOOKS=100
# PRO_STORAGE_GB=20

# ─── Legal pages (/terms, /privacy, /copyright) ────────────────────────
# Who runs the site, and how to reach you. Set these before launch (see DEPLOY.md).
LEGAL_NAME=
CONTACT_EMAIL=
# Name and postal address of your copyright agent; use \n for new lines
COPYRIGHT_AGENT=
LEGAL_UPDATED=

# A program to feature on the landing page ("Programs on Coursebook"), by its
# public page's slug, e.g. 1600 for /p/1600. Its page must be set to public on
# the program page. Leave empty on a deployment that features none.
FEATURED_PROGRAM_SLUG=

# One-click demo log-ins on /login, for a demo or staging copy filled with
# `npm run seed:demo` (invented people, a published password). Ignored when
# APP_ENV=production. Staff demo accounts have no two-factor login, so a demo
# copy also needs STAFF_TWO_FACTOR=off.
DEMO_LOGINS=false
