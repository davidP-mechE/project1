// Coursebook database schema.
// Phase 1: accounts (Better Auth tables), books and courses.
// Phase 2: extracted pages, figures, text chunks, units/lessons (outline), jobs.
// Phase 3: lesson skip flag, course settings, detected outline.
// Phase 4: generated lesson content, questions, flashcards, API usage.
// Phase 5: lesson progress (completion) and practice question attempts.
// Phase 6: flashcard review (spaced repetition), highlights, notes, full-text search.
// Phase 7: passage embeddings (pgvector) and the "Ask the book" tutor.
// Phase 8: study preferences, daily activity (streaks, goals), study plans, reminders.
// Phase 9: unit summaries, unit tests and the final exam (assessments).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts (shape required by Better Auth) ────────────────────────────

enum Role {
  USER
  ADMIN
}

// Plan only gates usage limits. Payments (Stripe) come later and will just set this.
enum Plan {
  FREE
  PRO
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role     Role   @default(USER)
  plan     Plan   @default(FREE)
  timezone String @default("UTC")

  // Study preferences (Settings → Studying)
  dailyGoalMinutes Int     @default(20)
  newCardsPerDay   Int     @default(20)
  reminderEmails   Boolean @default(false)
  reminderHour     Int     @default(18) // local hour (0-23) for the daily reminder
  lastReminderOn   String? // local date (YYYY-MM-DD) the last reminder was sent, so it's never sent twice a day

  sessions Session[]
  accounts Account[]
  books    Book[]
  courses  Course[]

  lessonProgress     LessonProgress[]
  questionAttempts   QuestionAttempt[]
  cardStates         CardState[]
  reviewLogs         ReviewLog[]
  highlights         Highlight[]
  notes              Note[]
  tutorThreads       TutorThread[]
  assessmentAttempts AssessmentAttempt[]
  studyDays          StudyDay[]
  studyPlans         StudyPlan[]
  analyticsEvents    AnalyticsEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // scrypt hash, never the plain password
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Login/sign-up rate limits (managed by Better Auth). Kept in the database so
// limits hold across several web servers (e.g. Vercel functions).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─── Books (the uploaded PDF files) ─────────────────────────────────────

enum BookStatus {
  AWAITING_UPLOAD // record created, browser is uploading the file
  UPLOADED // file stored and validated, waiting for processing
  PROCESSING
  READY
  FAILED
}

// A textbook, or a deck of lecture slides (PDF or PowerPoint). Both become a course.
enum SourceKind {
  BOOK
  SLIDES
}

model Book {
  id                String     @id @default(cuid())
  kind              SourceKind @default(BOOK)
  // PowerPoint decks: the uploaded .pptx. The worker turns it into the PDF at storageKey.
  sourceKey         String?
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename  String
  // Not unique: courses added from the Hub share the provided course's file.
  storageKey        String
  sizeBytes         BigInt
  pageCount         Int?
  coverKey          String?
  status            BookStatus @default(AWAITING_UPLOAD)
  error             String?
  rightsConfirmed   Boolean    @default(false)
  // Set by processing: did the PDF have built-in bookmarks?
  hasBuiltInOutline Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  course  Course?
  pages   Page[]
  figures Figure[]
  chunks  Chunk[]
  jobs    Job[]

  @@index([userId, createdAt])
}

// ─── Courses (one per book) ──────────────────────────────────────────────

enum CourseStatus {
  UPLOADING
  PROCESSING // extracting text / OCR / outline (Phase 2)
  OUTLINE_DRAFT // student reviews the outline (Phase 3)
  GENERATING // lessons being written (Phase 4)
  ACTIVE
  FAILED
}

model Course {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String         @unique
  book            Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title           String
  status          CourseStatus   @default(UPLOADING)
  archivedAt      DateTime?
  lastOpenedAt    DateTime?
  // Cached completion percentage (0-100), recomputed when lesson progress changes.
  progressPct     Int            @default(0)
  // Where the outline came from: the PDF's bookmarks, detected headings, or fixed page ranges.
  outlineSource   OutlineSource?
  // The outline exactly as processing detected it, so the student can reset their edits.
  detectedOutline Json?
  // Level, explanation style, content types… (validated by src/lib/course/settings.ts)
  settings        Json?
  // Subject for the Mastery page (src/lib/subjects.ts): detected from the book, changeable by the student.
  subject         String?
  // Added from the Hub: the provided course it was copied from.
  catalogEntryId  String?
  catalogEntry    CatalogEntry?  @relation("enrollments", fields: [catalogEntryId], references: [id], onDelete: SetNull)
  // This course is the source of a Hub entry (admins only).
  publishedAs     CatalogEntry?  @relation("source")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  units      Unit[]
  lessons    Lesson[]
  jobs       Job[]
  batches    GenerationBatch[]
  questions  Question[]
  flashcards Flashcard[]

  lessonProgress     LessonProgress[]
  questionAttempts   QuestionAttempt[]
  cardStates         CardState[]
  reviewLogs         ReviewLog[]
  highlights         Highlight[]
  notes              Note[]
  tutorThreads       TutorThread[]
  studyPlans         StudyPlan[]
  assessments        Assessment[]
  assessmentAttempts AssessmentAttempt[]

  @@index([userId, archivedAt])
}

enum OutlineSource {
  BOOKMARKS
  HEADINGS
  PAGE_RANGES
  SLIDES
}

// ─── Extracted content (Phase 2) ─────────────────────────────────────────

enum TextSource {
  NATIVE // text layer inside the PDF
  OCR // recognised from a rendered image of the page
  NONE // no usable text (blank page, or OCR found nothing)
}

model Page {
  id                String     @id @default(cuid())
  bookId            String
  book              Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber        Int // physical page, 1-based (what the PDF viewer shows)
  label             String? // printed page number if the PDF defines one, e.g. "xii" or "47"
  text              String
  charCount         Int
  textSource        TextSource @default(NATIVE)
  ocrConfidence     Float? // 0-100, only for OCR pages
  // 0-1: how equation-heavy the page looks. High scores get flagged before lesson generation.
  mathScore         Float      @default(0)
  imageCount        Int        @default(0)
  isFrontBackMatter Boolean    @default(false)
  // Text lines with font sizes, kept so the outline can be re-detected without re-reading the PDF.
  lines             Json?
  // Equation-heavy pages re-read from an image by Claude, with math as LaTeX (Phase 4).
  repairedText      String?
  repairedAt        DateTime?
  repairModel       String? // which model re-read it (High quality courses re-read pages a cheaper model read)
  width             Float
  height            Float

  @@unique([bookId, pageNumber])
}

model Figure {
  id         String @id @default(cuid())
  bookId     String
  book       Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber Int
  index      Int // order on the page
  storageKey String
  width      Int
  height     Int

  @@unique([bookId, pageNumber, index])
}

// Passages of ~400 tokens used for search and the tutor (embeddings added in Phase 7).
model Chunk {
  id             String                   @id @default(cuid())
  bookId         String
  book           Book                     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ordinal        Int
  pageStart      Int
  pageEnd        Int
  text           String
  tokenCount     Int
  // Full-text search vector, a generated column maintained by Postgres.
  tsv            Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, text)"))
  // Meaning vector for the tutor (pgvector), and which model made it (re-embedded if the model changes).
  embedding      Unsupported("vector")?
  embeddingModel String?

  @@unique([bookId, ordinal])
  @@index([tsv], type: Gin)
  @@index([bookId, pageStart])
  @@index([bookId, embeddingModel])
}

// ─── Course structure (outline) ─────────────────────────────────────────

model Unit {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  isFrontBackMatter Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lessons     Lesson[]
  assessments Assessment[]

  @@index([courseId, order])
}

enum LessonStatus {
  PENDING
  QUEUED
  GENERATING
  READY
  FLAGGED
  FAILED
}

model Lesson {
  id                String       @id @default(cuid())
  unitId            String
  unit              Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  pageStart         Int
  pageEnd           Int
  isFrontBackMatter Boolean      @default(false)
  // Student's choice to leave this lesson out of the course (starts as true for front/back matter).
  skip              Boolean      @default(false)
  status            LessonStatus @default(PENDING)
  // Generated content: objectives, explanation, worked examples, key terms (see src/lib/ai/lesson-schema.ts).
  content           Json?
  // Hash of everything that went into generating it (source text, settings, prompt, model).
  // If nothing changed, the lesson isn't regenerated.
  cacheKey          String?
  model             String?
  promptVersion     String?
  generatedAt       DateTime?
  userEdited        Boolean      @default(false)
  // Why the lesson was flagged instead of generated, or why generation failed.
  flagReason        String?
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  questions    Question[]
  flashcards   Flashcard[]
  progress     LessonProgress[]
  attempts     QuestionAttempt[]
  highlights   Highlight[]
  notes        Note[]
  tutorThreads TutorThread[]
  planItems    PlanItem[]
  // Full-text search vector (title + content), a generated column maintained by Postgres.
  tsv          Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, title), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(content, '{}'::jsonb)), 'B'::\"char\"))"))

  @@index([unitId, order])
  @@index([tsv], type: Gin)
  @@index([courseId])
}

enum QuestionScope {
  LESSON
  UNIT_TEST
  FINAL_EXAM
  DRILL // extra questions written on demand to hammer one skill (Review)
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  STEP_BY_STEP
}

model Question {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  scope         QuestionScope @default(LESSON)
  type          QuestionType
  order         Int
  prompt        String
  choices       String[] // multiple choice only
  correctChoice Int? // index into choices
  answer        String // the correct answer, in words
  explanation   String
  steps         String[] // step-by-step solution (step-by-step problems)
  pageRefs      Int[]
  topic         String // short topic label, used later for "weak topics"
  userEdited    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  // Unit test / final exam questions belong to an assessment instead of a lesson.
  assessmentId  String?
  assessment    Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  attempts QuestionAttempt[]

  @@index([lessonId, order])
  @@index([courseId])
}

model Flashcard {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order      Int
  front      String
  back       String
  pageRefs   Int[]
  userEdited Boolean  @default(false)
  createdAt  DateTime @default(now())

  states     CardState[]
  reviewLogs ReviewLog[]

  @@index([lessonId, order])
  @@index([courseId])
}

// ─── Studying (Phase 5) ──────────────────────────────────────────────────

/**
 * One row per student per lesson they've opened.
 */
model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  // The student marked this lesson "I found this confusing" (used for weak topics in Phase 8).
  confusing    Boolean   @default(false)
  lastViewedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

enum AttemptVerdict {
  CORRECT
  PARTIAL
  INCORRECT
}

enum GradedBy {
  LOCAL // multiple choice, or an exact/numeric match checked without Claude
  CLAUDE
  DEMO // FAKE_CLAUDE mode: a rough word-overlap check, clearly labelled
}

/**
 * Every answer a student submits to a practice question.
 * If the question is later regenerated, the attempt is kept (questionId becomes
 * null) with a copy of its topic, so the history still counts for weak topics.
 */
model QuestionAttempt {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId            String?
  lesson              Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questionId          String?
  question            Question?          @relation(fields: [questionId], references: [id], onDelete: SetNull)
  topic               String
  choice              Int? // multiple choice: the option picked
  response            String // short answer / step-by-step: what the student wrote
  verdict             AttemptVerdict
  correct             Boolean
  score               Float // 0-1
  feedback            String
  gradedBy            GradedBy
  model               String?
  createdAt           DateTime           @default(now())
  // Answers given as part of a unit test / final exam.
  assessmentAttemptId String?
  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)

  @@index([questionId, userId, createdAt])
  @@index([userId, createdAt])
  @@index([courseId, userId])
}

// ─── Flashcard review, highlights and notes (Phase 6) ────────────────────

enum SrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/**
 * A student's spaced-repetition state for one flashcard (FSRS, see src/lib/srs).
 * A flashcard with no row here is "new" for that student.
 */
model CardState {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  flashcardId   String
  flashcard     Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  learningSteps Int
  reps          Int
  lapses        Int
  state         SrsState
  lastReview    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, flashcardId])
  @@index([userId, due])
}

/**
 * Every rating a student gives. Kept if the card is later deleted (for stats and streaks).
 */
model ReviewLog {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  flashcardId   String?
  flashcard     Flashcard? @relation(fields: [flashcardId], references: [id], onDelete: SetNull)
  rating        Int // 1 Again, 2 Hard, 3 Good, 4 Easy
  stateBefore   SrsState
  dueBefore     DateTime?
  scheduledDays Int // interval chosen by this review
  durationMs    Int?
  reviewedAt    DateTime   @default(now())

  @@index([userId, reviewedAt])
  @@index([flashcardId])
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
}

/**
 * A highlighted passage of lesson text. Anchored by the quoted text plus a
 * little context before and after (not by position), so it survives small
 * changes. If the lesson is rewritten and the text is gone, it's kept and
 * listed on the Notes page as "no longer in the lesson".
 */
model Highlight {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exact     String
  prefix    String
  suffix    String
  color     HighlightColor @default(YELLOW)
  note      String         @default("")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, lessonId])
  @@index([courseId, userId])
}

/**
 * A student's own notes on a lesson (Markdown).
 */
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([courseId, userId])
}

// ─── "Ask the book" tutor (Phase 7) ──────────────────────────────────────

/**
 * One conversation with the tutor. Optionally started from a lesson (its pages are preferred).
 */
model TutorThread {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TutorMessage[]

  @@index([userId, courseId, updatedAt])
}

enum TutorRole {
  USER
  ASSISTANT
}

enum TutorMessageStatus {
  STREAMING
  DONE
  STOPPED // the student stopped it or left the page; what was written so far is kept
  ERROR
}

model TutorMessage {
  id         String             @id @default(cuid())
  threadId   String
  thread     TutorThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       TutorRole
  content    String
  status     TutorMessageStatus @default(DONE)
  // Assistant only: the book passages it was given ([{chunkId, pageStart, pageEnd}]) and the pages it cited.
  sources    Json?
  citedPages Int[]
  // Assistant only: the answer says the book doesn't cover the question.
  notInBook  Boolean            @default(false)
  error      String?
  createdAt  DateTime           @default(now())

  @@index([threadId, createdAt])
}

// ─── Dashboard, streaks, study plans (Phase 8) ──────────────────────────

/**
 * One row per student per day they studied, in THEIR time zone (day = "2026-11-09").
 * Drives streaks, the daily goal and the activity chart. Minutes come from a
 * heartbeat while a study page is open and in use; counts are bumped as things happen.
 */
model StudyDay {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day               String
  minutes           Int       @default(0)
  cardsReviewed     Int       @default(0)
  questionsAnswered Int       @default(0)
  questionsCorrect  Int       @default(0)
  lessonsCompleted  Int       @default(0)
  lastActiveAt      DateTime?

  @@unique([userId, day])
}

/**
 * A plan to finish a course by a date: which lessons on which days.
 */
model StudyPlan {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startDate     String // local date the plan was (re)made
  targetDate    String // local date to finish by
  studyDays     Int[] // weekdays to study, 0 = Sunday … 6 = Saturday
  minutesPerDay Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         PlanItem[]

  @@unique([userId, courseId])
}

enum PlanItemKind {
  LESSON
  REVIEW
}

model PlanItem {
  id       String       @id @default(cuid())
  planId   String
  plan     StudyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  day      String
  kind     PlanItemKind
  lessonId String?
  lesson   Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  minutes  Int
  order    Int

  @@index([planId, day])
}

// ─── Unit tests and final exam (Phase 9) ────────────────────────────────

enum AssessmentKind {
  UNIT_TEST
  FINAL_EXAM
}

enum AssessmentStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

/**
 * A unit's summary + test, or the course's final exam. Written by Claude from
 * the unit's finished lessons once they're all done. Its questions are
 * Question rows (scope UNIT_TEST / FINAL_EXAM) pointing here.
 */
model Assessment {
  id          String           @id @default(cuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unitId      String? // null for the final exam
  unit        Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  kind        AssessmentKind
  status      AssessmentStatus @default(QUEUED)
  summary     String? // unit summary (Markdown)
  error       String?
  model       String?
  generatedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  questions Question[]
  attempts  AssessmentAttempt[]

  @@index([courseId, kind])
  @@index([unitId])
}

/**
 * One time a student took a unit test or the final exam. Each answer is a QuestionAttempt.
 */
model AssessmentAttempt {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score        Float // 0-1
  correct      Int
  total        Int
  createdAt    DateTime          @default(now())
  answers      QuestionAttempt[]

  @@index([userId, assessmentId, createdAt])
}

// ─── Claude API usage (for cost tracking and limits) ─────────────────────

enum UsageFeature {
  LESSON
  FLASHCARDS
  QUESTIONS
  ASSESSMENT
  PAGE_REPAIR
  GRADING
  TUTOR
}

model UsageEvent {
  id               String       @id @default(cuid())
  userId           String
  courseId         String?
  lessonId         String?
  feature          UsageFeature
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  costMicroUsd     Int // millionths of a dollar
  batch            Boolean      @default(false) // sent through the Message Batches API (half price)
  createdAt        DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([courseId])
}

// ─── Claude Message Batches ──────────────────────────────────────────────
// Whole-course generation is sent to Claude as one batch (half price, results
// usually within an hour). One row per submitted batch; the worker polls it.

enum GenerationBatchStatus {
  SUBMITTED
  PROCESSED
  FAILED
}

model GenerationBatch {
  id           String                @id // Claude's batch id (msgbatch_…)
  courseId     String
  userId       String
  status       GenerationBatchStatus @default(SUBMITTED)
  /// custom_id -> what the request was for ({ kind, lessonId | assessmentId, cacheKey? })
  items        Json
  /// custom_ids whose results have been saved (so a retried poll never saves twice)
  processedIds String[]              @default([])
  requestCount Int
  createdAt    DateTime              @default(now())
  endedAt      DateTime?
  course       Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
}

// ─── Background jobs ─────────────────────────────────────────────────────
// Mirrors each queue job so the app can show live status and the admin page can list failures.

enum JobType {
  PROCESS_BOOK
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  type        JobType
  status      JobStatus @default(QUEUED)
  bookId      String?
  book        Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  step        String? // machine-readable current step, e.g. "ocr"
  progress    Int       @default(0) // 0-100
  message     String? // shown to the student, e.g. "OCR on page 112 of 340…"
  error       String? // friendly error shown to the student
  errorDetail String? // technical detail for the admin page
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([bookId, createdAt])
  @@index([status, createdAt])
}

// ─── Product analytics (our own, no third-party trackers) ─────────────────
// Counts of feature use for the admin page. When an account is deleted its
// events stay, without the user id.

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

// ─── Hub: provided courses (e.g. OpenStax books) ─────────────────────────
// An admin generates a course as usual and publishes it. Students add it to
// their library: they get their own copy of the course (progress, notes and
// all), sharing the provided book's files under catalog/<entry id>/.

model CatalogEntry {
  id             String   @id @default(cuid())
  sourceCourseId String   @unique
  sourceCourse   Course   @relation("source", fields: [sourceCourseId], references: [id], onDelete: Cascade)
  title          String
  subject        String
  description    String
  license        String // e.g. "CC BY 4.0"
  attribution    String // shown with the course, as the license requires
  sourceUrl      String?
  fileKey        String // catalog/<id>/original.pdf
  coverKey       String?
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments Course[] @relation("enrollments")

  @@index([published, subject])
}
