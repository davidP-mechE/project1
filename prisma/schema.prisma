// Coursebook database schema.
// Phase 1: accounts (Better Auth tables), books and courses.
// Phase 2: extracted pages, figures, text chunks, units/lessons (outline), jobs.
// Phase 3: lesson skip flag, course settings, detected outline.
// Phase 4: generated lesson content, questions, flashcards, API usage.
// Phase 5: lesson progress (completion) and practice question attempts.
// Phase 6: flashcard review (spaced repetition), highlights, notes, full-text search.
// Phase 7: passage embeddings (pgvector) and the "Ask the book" tutor.
// Phase 8: study preferences, daily activity (streaks, goals), study plans, reminders.
// Phase 9: unit summaries, unit tests and the final exam (assessments).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts (shape required by Better Auth) ────────────────────────────

enum Role {
  USER
  ADMIN
}

// Plan only gates usage limits. Payments (Stripe) come later and will just set this.
enum Plan {
  FREE
  PRO
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role     Role   @default(USER)
  plan     Plan   @default(FREE)
  timezone String @default("UTC")

  // Study preferences (Settings → Studying)
  dailyGoalMinutes Int     @default(20)
  newCardsPerDay   Int     @default(20)
  reminderEmails   Boolean @default(false)
  reminderHour     Int     @default(18) // local hour (0-23) for the daily reminder
  lastReminderOn   String? // local date (YYYY-MM-DD) the last reminder was sent, so it's never sent twice a day

  sessions Session[]
  accounts Account[]
  books    Book[]
  courses  Course[]

  lessonProgress     LessonProgress[]
  questionAttempts   QuestionAttempt[]
  cardStates         CardState[]
  reviewLogs         ReviewLog[]
  highlights         Highlight[]
  notes              Note[]
  tutorThreads       TutorThread[]
  assessmentAttempts AssessmentAttempt[]
  studyDays          StudyDay[]
  studyPlans         StudyPlan[]
  analyticsEvents    AnalyticsEvent[]
  teaching           Class[]             @relation("teacher")
  classMemberships   ClassMember[]
  worksheets         Worksheet[]
  assignmentAnswers  AssignmentAnswer[]
  assignmentStarts   AssignmentStart[]
  programsAdmin      Program[]           @relation("programAdmin")
  classStaff         ClassStaff[]        @relation("staffUser")
  groupMemberships   ClassGroupMember[]

  scoreRecords       ScoreRecord[]       @relation("scores")
  studentProfile     StudentProfile?
  externalResults    ExternalResult[]
  diagnosticAttempts DiagnosticAttempt[]
  mistakes           MistakeItem[]
  attendance         AttendanceRecord[]
  guardians          GuardianContact[]
  /// Staff: a daily email of new alerts.
  staffDigest        Boolean             @default(false)
  /// First-login walkthroughs already seen (e.g. "student", "staff").
  toursSeen          String[]
  /// Per-type notification choices: { messages: { site, email }, ... }. Missing keys use the defaults in src/lib/notification-prefs.ts.
  notificationPrefs  Json                @default("{}")
  /// Private calendar feed link (/api/calendar/<token>.ics). Reset from the calendar page to revoke the old one.
  calendarToken      String?             @unique
  notifications      Notification[]
  threadsAsStudent   MessageThread[]     @relation("threadStudent")
  threadsAsStaff     MessageThread[]     @relation("threadStaff")
  messages           Message[]
  threadReads        ThreadRead[]
  announcements      Announcement[]
  badges             Badge[]

  /// Set on every login, for the Staff page.
  lastLoginAt      DateTime?
  /// Two-factor login (authenticator app); required for program admins and staff.
  twoFactorEnabled Boolean?    @default(false)
  twoFactors       TwoFactor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // scrypt hash, never the plain password
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Login/sign-up rate limits (managed by Better Auth). Kept in the database so
// limits hold across several web servers (e.g. Vercel functions).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─── Books (the uploaded PDF files) ─────────────────────────────────────

enum BookStatus {
  AWAITING_UPLOAD // record created, browser is uploading the file
  UPLOADED // file stored and validated, waiting for processing
  PROCESSING
  READY
  FAILED
}

// A textbook, or a deck of lecture slides (PDF or PowerPoint). Both become a course.
enum SourceKind {
  BOOK
  SLIDES
}

model Book {
  id                String     @id @default(cuid())
  kind              SourceKind @default(BOOK)
  // PowerPoint decks: the uploaded .pptx. The worker turns it into the PDF at storageKey.
  sourceKey         String?
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename  String
  // Not unique: courses added from the Hub share the provided course's file.
  storageKey        String
  sizeBytes         BigInt
  pageCount         Int?
  coverKey          String?
  status            BookStatus @default(AWAITING_UPLOAD)
  error             String?
  rightsConfirmed   Boolean    @default(false)
  // Set by processing: did the PDF have built-in bookmarks?
  hasBuiltInOutline Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  course  Course?
  decks   Deck[]
  pages   Page[]
  figures Figure[]
  chunks  Chunk[]
  jobs    Job[]

  @@index([userId, createdAt])
}

// ─── Slide collages ──────────────────────────────────────────────────────
// A slides course can be made of several decks. They're merged, in order, into
// the book's one PDF (so lessons, the viewer and search work as usual); each
// deck becomes a unit. Decks can be added later without touching what's written.

enum DeckStatus {
  AWAITING_UPLOAD
  UPLOADED // stored and checked; waiting to be merged
  MERGED // its slides are in the book's PDF; its unit isn't made yet
  READY // in the outline as a unit
  FAILED
}

model Deck {
  id               String     @id @default(cuid())
  bookId           String
  book             Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  originalFilename String
  storageKey       String // the uploaded PDF or .pptx
  isPptx           Boolean    @default(false)
  sizeBytes        BigInt
  status           DeckStatus @default(AWAITING_UPLOAD)
  error            String?
  // Where its slides are in the book's PDF, once merged.
  pageStart        Int?
  pageEnd          Int?
  createdAt        DateTime   @default(now())

  @@unique([bookId, order])
  @@index([bookId, status])
}

// ─── Courses (one per book) ──────────────────────────────────────────────

enum CourseStatus {
  UPLOADING
  PROCESSING // extracting text / OCR / outline (Phase 2)
  OUTLINE_DRAFT // student reviews the outline (Phase 3)
  GENERATING // lessons being written (Phase 4)
  ACTIVE
  FAILED
}

model Course {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String         @unique
  book            Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title           String
  status          CourseStatus   @default(UPLOADING)
  archivedAt      DateTime?
  lastOpenedAt    DateTime?
  // Cached completion percentage (0-100), recomputed when lesson progress changes.
  progressPct     Int            @default(0)
  // Where the outline came from: the PDF's bookmarks, detected headings, or fixed page ranges.
  outlineSource   OutlineSource?
  // The outline exactly as processing detected it, so the student can reset their edits.
  detectedOutline Json?
  // Level, explanation style, content types… (validated by src/lib/course/settings.ts)
  settings        Json?
  // Subject for the Mastery page (src/lib/subjects.ts): detected from the book, changeable by the student.
  subject         String?
  // Added from the Hub: the provided course it was copied from.
  catalogEntryId  String?
  catalogEntry    CatalogEntry?  @relation("enrollments", fields: [catalogEntryId], references: [id], onDelete: SetNull)
  // A student's copy of a course their teacher assigned in a class.
  classCourseId   String?
  classCourse     ClassCourse?   @relation("classCopies", fields: [classCourseId], references: [id], onDelete: SetNull)
  sharedInClasses ClassCourse[]  @relation("classSource")
  // This course is the source of a Hub entry (admins only).
  publishedAs     CatalogEntry?  @relation("source")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  units      Unit[]
  lessons    Lesson[]
  jobs       Job[]
  batches    GenerationBatch[]
  questions  Question[]
  flashcards Flashcard[]

  lessonProgress     LessonProgress[]
  questionAttempts   QuestionAttempt[]
  cardStates         CardState[]
  reviewLogs         ReviewLog[]
  highlights         Highlight[]
  notes              Note[]
  tutorThreads       TutorThread[]
  studyPlans         StudyPlan[]
  assessments        Assessment[]
  assessmentAttempts AssessmentAttempt[]

  @@index([userId, archivedAt])
}

enum OutlineSource {
  BOOKMARKS
  HEADINGS
  PAGE_RANGES
  SLIDES
}

// ─── Extracted content (Phase 2) ─────────────────────────────────────────

enum TextSource {
  NATIVE // text layer inside the PDF
  OCR // recognised from a rendered image of the page
  NONE // no usable text (blank page, or OCR found nothing)
}

model Page {
  id                String     @id @default(cuid())
  bookId            String
  book              Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber        Int // physical page, 1-based (what the PDF viewer shows)
  label             String? // printed page number if the PDF defines one, e.g. "xii" or "47"
  text              String
  charCount         Int
  textSource        TextSource @default(NATIVE)
  ocrConfidence     Float? // 0-100, only for OCR pages
  // 0-1: how equation-heavy the page looks. High scores get flagged before lesson generation.
  mathScore         Float      @default(0)
  imageCount        Int        @default(0)
  isFrontBackMatter Boolean    @default(false)
  // Text lines with font sizes, kept so the outline can be re-detected without re-reading the PDF.
  lines             Json?
  // Equation-heavy pages re-read from an image by Claude, with math as LaTeX (Phase 4).
  repairedText      String?
  repairedAt        DateTime?
  repairModel       String? // which model re-read it (High quality courses re-read pages a cheaper model read)
  width             Float
  height            Float

  @@unique([bookId, pageNumber])
}

model Figure {
  id         String @id @default(cuid())
  bookId     String
  book       Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber Int
  index      Int // order on the page
  storageKey String
  width      Int
  height     Int

  @@unique([bookId, pageNumber, index])
}

// Passages of ~400 tokens used for search and the tutor (embeddings added in Phase 7).
model Chunk {
  id             String                   @id @default(cuid())
  bookId         String
  book           Book                     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ordinal        Int
  pageStart      Int
  pageEnd        Int
  text           String
  tokenCount     Int
  // Full-text search vector, a generated column maintained by Postgres.
  tsv            Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, text)"))
  // Meaning vector for the tutor (pgvector), and which model made it (re-embedded if the model changes).
  embedding      Unsupported("vector")?
  embeddingModel String?

  @@unique([bookId, ordinal])
  @@index([tsv], type: Gin)
  @@index([bookId, pageStart])
  @@index([bookId, embeddingModel])
}

// ─── Course structure (outline) ─────────────────────────────────────────

model Unit {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  isFrontBackMatter Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lessons     Lesson[]
  assessments Assessment[]

  @@index([courseId, order])
}

enum LessonStatus {
  PENDING
  QUEUED
  GENERATING
  READY
  FLAGGED
  FAILED
}

model Lesson {
  id                String       @id @default(cuid())
  // In a copied course (Hub or class): the lesson it was copied from, so a teacher's assignment finds it.
  sourceLessonId    String?
  unitId            String
  unit              Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  pageStart         Int
  pageEnd           Int
  isFrontBackMatter Boolean      @default(false)
  // Student's choice to leave this lesson out of the course (starts as true for front/back matter).
  skip              Boolean      @default(false)
  status            LessonStatus @default(PENDING)
  // Generated content: objectives, explanation, worked examples, key terms (see src/lib/ai/lesson-schema.ts).
  content           Json?
  // Hash of everything that went into generating it (source text, settings, prompt, model).
  // If nothing changed, the lesson isn't regenerated.
  cacheKey          String?
  model             String?
  promptVersion     String?
  generatedAt       DateTime?
  userEdited        Boolean      @default(false)
  // Why the lesson was flagged instead of generated, or why generation failed.
  flagReason        String?
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  questions    Question[]
  flashcards   Flashcard[]
  progress     LessonProgress[]
  attempts     QuestionAttempt[]
  highlights   Highlight[]
  notes        Note[]
  tutorThreads TutorThread[]
  planItems    PlanItem[]
  // Full-text search vector (title + content), a generated column maintained by Postgres.
  tsv          Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, title), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(content, '{}'::jsonb)), 'B'::\"char\"))"))

  @@index([unitId, order])
  @@index([tsv], type: Gin)
  @@index([courseId])
  @@index([sourceLessonId])
}

enum QuestionScope {
  LESSON
  UNIT_TEST
  FINAL_EXAM
  DRILL // extra questions written on demand to hammer one skill (Review)
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  STEP_BY_STEP
}

model Question {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  scope         QuestionScope @default(LESSON)
  type          QuestionType
  order         Int
  prompt        String
  choices       String[] // multiple choice only
  correctChoice Int? // index into choices
  answer        String // the correct answer, in words
  explanation   String
  steps         String[] // step-by-step solution (step-by-step problems)
  pageRefs      Int[]
  topic         String // short topic label, used later for "weak topics"
  userEdited    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  // Unit test / final exam questions belong to an assessment instead of a lesson.
  assessmentId  String?
  assessment    Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  attempts QuestionAttempt[]

  @@index([lessonId, order])
  @@index([courseId])
}

model Flashcard {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order      Int
  front      String
  back       String
  pageRefs   Int[]
  userEdited Boolean  @default(false)
  createdAt  DateTime @default(now())

  states     CardState[]
  reviewLogs ReviewLog[]

  @@index([lessonId, order])
  @@index([courseId])
}

// ─── Studying (Phase 5) ──────────────────────────────────────────────────

/**
 * One row per student per lesson they've opened.
 */
model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  // The student marked this lesson "I found this confusing" (used for weak topics in Phase 8).
  confusing    Boolean   @default(false)
  lastViewedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

enum AttemptVerdict {
  CORRECT
  PARTIAL
  INCORRECT
}

enum GradedBy {
  LOCAL // multiple choice, or an exact/numeric match checked without Claude
  CLAUDE
  DEMO // FAKE_CLAUDE mode: a rough word-overlap check, clearly labelled
}

/**
 * Every answer a student submits to a practice question.
 * If the question is later regenerated, the attempt is kept (questionId becomes
 * null) with a copy of its topic, so the history still counts for weak topics.
 */
model QuestionAttempt {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId            String?
  lesson              Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questionId          String?
  question            Question?          @relation(fields: [questionId], references: [id], onDelete: SetNull)
  topic               String
  choice              Int? // multiple choice: the option picked
  response            String // short answer / step-by-step: what the student wrote
  verdict             AttemptVerdict
  correct             Boolean
  score               Float // 0-1
  feedback            String
  gradedBy            GradedBy
  model               String?
  createdAt           DateTime           @default(now())
  // Answers given as part of a unit test / final exam.
  assessmentAttemptId String?
  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)

  @@index([questionId, userId, createdAt])
  @@index([userId, createdAt])
  @@index([courseId, userId])
}

// ─── Flashcard review, highlights and notes (Phase 6) ────────────────────

enum SrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/**
 * A student's spaced-repetition state for one flashcard (FSRS, see src/lib/srs).
 * A flashcard with no row here is "new" for that student.
 */
model CardState {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  flashcardId   String
  flashcard     Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  learningSteps Int
  reps          Int
  lapses        Int
  state         SrsState
  lastReview    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, flashcardId])
  @@index([userId, due])
}

/**
 * Every rating a student gives. Kept if the card is later deleted (for stats and streaks).
 */
model ReviewLog {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  flashcardId   String?
  flashcard     Flashcard? @relation(fields: [flashcardId], references: [id], onDelete: SetNull)
  rating        Int // 1 Again, 2 Hard, 3 Good, 4 Easy
  stateBefore   SrsState
  dueBefore     DateTime?
  scheduledDays Int // interval chosen by this review
  durationMs    Int?
  reviewedAt    DateTime   @default(now())

  @@index([userId, reviewedAt])
  @@index([flashcardId])
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
}

/**
 * A highlighted passage of lesson text. Anchored by the quoted text plus a
 * little context before and after (not by position), so it survives small
 * changes. If the lesson is rewritten and the text is gone, it's kept and
 * listed on the Notes page as "no longer in the lesson".
 */
model Highlight {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exact     String
  prefix    String
  suffix    String
  color     HighlightColor @default(YELLOW)
  note      String         @default("")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, lessonId])
  @@index([courseId, userId])
}

/**
 * A student's own notes on a lesson (Markdown).
 */
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([courseId, userId])
}

// ─── "Ask the book" tutor (Phase 7) ──────────────────────────────────────

/**
 * One conversation with the tutor. Optionally started from a lesson (its pages are preferred).
 */
model TutorThread {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TutorMessage[]

  @@index([userId, courseId, updatedAt])
}

enum TutorRole {
  USER
  ASSISTANT
}

enum TutorMessageStatus {
  STREAMING
  DONE
  STOPPED // the student stopped it or left the page; what was written so far is kept
  ERROR
}

model TutorMessage {
  id         String             @id @default(cuid())
  threadId   String
  thread     TutorThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       TutorRole
  content    String
  status     TutorMessageStatus @default(DONE)
  // Assistant only: the book passages it was given ([{chunkId, pageStart, pageEnd}]) and the pages it cited.
  sources    Json?
  citedPages Int[]
  // Assistant only: the answer says the book doesn't cover the question.
  notInBook  Boolean            @default(false)
  error      String?
  createdAt  DateTime           @default(now())

  @@index([threadId, createdAt])
}

// ─── Dashboard, streaks, study plans (Phase 8) ──────────────────────────

/**
 * One row per student per day they studied, in THEIR time zone (day = "2026-11-09").
 * Drives streaks, the daily goal and the activity chart. Minutes come from a
 * heartbeat while a study page is open and in use; counts are bumped as things happen.
 */
model StudyDay {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day               String
  minutes           Int       @default(0)
  cardsReviewed     Int       @default(0)
  questionsAnswered Int       @default(0)
  questionsCorrect  Int       @default(0)
  lessonsCompleted  Int       @default(0)
  lastActiveAt      DateTime?

  @@unique([userId, day])
}

/**
 * A plan to finish a course by a date: which lessons on which days.
 */
model StudyPlan {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startDate     String // local date the plan was (re)made
  targetDate    String // local date to finish by
  studyDays     Int[] // weekdays to study, 0 = Sunday … 6 = Saturday
  minutesPerDay Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         PlanItem[]

  @@unique([userId, courseId])
}

enum PlanItemKind {
  LESSON
  REVIEW
}

model PlanItem {
  id       String       @id @default(cuid())
  planId   String
  plan     StudyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  day      String
  kind     PlanItemKind
  lessonId String?
  lesson   Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  minutes  Int
  order    Int

  @@index([planId, day])
}

// ─── Unit tests and final exam (Phase 9) ────────────────────────────────

enum AssessmentKind {
  UNIT_TEST
  FINAL_EXAM
}

enum AssessmentStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

/**
 * A unit's summary + test, or the course's final exam. Written by Claude from
 * the unit's finished lessons once they're all done. Its questions are
 * Question rows (scope UNIT_TEST / FINAL_EXAM) pointing here.
 */
model Assessment {
  id          String           @id @default(cuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unitId      String? // null for the final exam
  unit        Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  kind        AssessmentKind
  status      AssessmentStatus @default(QUEUED)
  summary     String? // unit summary (Markdown)
  error       String?
  model       String?
  generatedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  questions Question[]
  attempts  AssessmentAttempt[]

  @@index([courseId, kind])
  @@index([unitId])
}

/**
 * One time a student took a unit test or the final exam. Each answer is a QuestionAttempt.
 */
model AssessmentAttempt {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score        Float // 0-1
  correct      Int
  total        Int
  createdAt    DateTime          @default(now())
  answers      QuestionAttempt[]

  @@index([userId, assessmentId, createdAt])
}

// ─── Claude API usage (for cost tracking and limits) ─────────────────────

enum UsageFeature {
  WORKSHEET
  LESSON
  FLASHCARDS
  QUESTIONS
  ASSESSMENT
  PAGE_REPAIR
  GRADING
  TUTOR
  CURRICULUM
  DRAFT
  SUMMARY
  ASSISTANT
}

model UsageEvent {
  id               String       @id @default(cuid())
  userId           String
  courseId         String?
  lessonId         String?
  feature          UsageFeature
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  costMicroUsd     Int // millionths of a dollar
  batch            Boolean      @default(false) // sent through the Message Batches API (half price)
  createdAt        DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([courseId])
}

// ─── Claude Message Batches ──────────────────────────────────────────────
// Whole-course generation is sent to Claude as one batch (half price, results
// usually within an hour). One row per submitted batch; the worker polls it.

enum GenerationBatchStatus {
  SUBMITTED
  PROCESSED
  FAILED
}

model GenerationBatch {
  id           String                @id // Claude's batch id (msgbatch_…)
  courseId     String
  userId       String
  status       GenerationBatchStatus @default(SUBMITTED)
  /// custom_id -> what the request was for ({ kind, lessonId | assessmentId, cacheKey? })
  items        Json
  /// custom_ids whose results have been saved (so a retried poll never saves twice)
  processedIds String[]              @default([])
  requestCount Int
  createdAt    DateTime              @default(now())
  endedAt      DateTime?
  course       Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
}

// ─── Background jobs ─────────────────────────────────────────────────────
// Mirrors each queue job so the app can show live status and the admin page can list failures.

enum JobType {
  PROCESS_BOOK
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  type        JobType
  status      JobStatus @default(QUEUED)
  bookId      String?
  book        Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  step        String? // machine-readable current step, e.g. "ocr"
  progress    Int       @default(0) // 0-100
  message     String? // shown to the student, e.g. "OCR on page 112 of 340…"
  error       String? // friendly error shown to the student
  errorDetail String? // technical detail for the admin page
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([bookId, createdAt])
  @@index([status, createdAt])
}

// ─── Product analytics (our own, no third-party trackers) ─────────────────
// Counts of feature use for the admin page. When an account is deleted its
// events stay, without the user id.

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

// ─── Hub: provided courses (e.g. OpenStax books) ─────────────────────────
// An admin generates a course as usual and publishes it. Students add it to
// their library: they get their own copy of the course (progress, notes and
// all), sharing the provided book's files under catalog/<entry id>/.

model CatalogEntry {
  id             String   @id @default(cuid())
  sourceCourseId String   @unique
  sourceCourse   Course   @relation("source", fields: [sourceCourseId], references: [id], onDelete: Cascade)
  title          String
  subject        String
  description    String
  license        String // e.g. "CC BY 4.0"
  attribution    String // shown with the course, as the license requires
  sourceUrl      String?
  fileKey        String // catalog/<id>/original.pdf
  coverKey       String?
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments Course[] @relation("enrollments")

  @@index([published, subject])
}

// ─── Classes (teachers and students) ─────────────────────────────────────
// Anyone can teach: create a class, invite students (by email or join code),
// and assign their own courses, or chosen lessons, with due dates. Each student
// gets their own copy of an assigned course (like the Hub), so their progress,
// notes and answers are theirs; the teacher sees progress on assigned work only.

/// A tutoring program (e.g. The 1600 Project): its classes, staff and settings.
model Program {
  id              String       @id @default(cuid())
  name            String
  adminId         String
  admin           User         @relation("programAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  /// Subject template: only SAT for now.
  subject         String       @default("SAT")
  /// Score targets shown on dashboards (e.g. 1200, 1300).
  targets         Int[]        @default([1200, 1300])
  /// Days a staff invite link stays valid.
  inviteDays      Int          @default(7)
  /// Program-wide AI spending cap per day, in cents (null = no cap beyond each user's allowance).
  aiDailyCapCents Int?
  /// UTC day (YYYY-MM-DD) the admin was last emailed that the cap was reached, so it's once a day.
  aiCapAlertedOn  String?
  /// Official SAT dates students can pick from (entered by the admin).
  testDates       DateTime[]
  /// School calendar: term dates and days with no sessions.
  termStart       DateTime?
  termEnd         DateTime?
  closedDates     DateTime[]
  /// Public identity (the program's own, not the site's): its address /p/<slug>, badge text and page copy.
  slug            String?      @unique
  badge           String?
  isPublic        Boolean      @default(false)
  publicBlurb     String?
  /// Starting point and goal shown on the public page (e.g. a school average of 970 and a +300 gain).
  schoolAverage   Int?
  goalGain        Int?
  diagnostics     Diagnostic[]
  createdAt       DateTime     @default(now())
  classes         Class[]
  auditLogs       AuditLog[]

  @@index([adminId])
}

/// Staff on a class. A specialist's scope: sections (MATH, RW), domains, groups; empty = no limit on that axis.
model ClassStaff {
  id             String    @id @default(cuid())
  classId        String
  class          Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation("staffUser", fields: [userId], references: [id], onDelete: Cascade)
  role           StaffRole
  sections       String[]
  domains        String[]
  groupIds       String[]
  canManageStaff Boolean   @default(false)
  addedById      String?
  createdAt      DateTime  @default(now())

  @@unique([classId, userId])
  @@index([userId])
}

enum StaffRole {
  TEACHER
  SPECIALIST
  VIEWER
}

model StaffInvite {
  id             String    @id @default(cuid())
  classId        String
  class          Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  email          String
  role           StaffRole
  sections       String[]
  domains        String[]
  groupIds       String[]
  canManageStaff Boolean   @default(false)
  /// sha256 of the link's token; the token itself is never stored.
  tokenHash      String    @unique
  expiresAt      DateTime
  invitedById    String
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([classId])
}

/// Append-only record of staff, role, scope, admin and grade-override changes. Nothing updates or deletes rows.
model AuditLog {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  targetType String
  targetId   String
  /// Readable summary, e.g. "Specialist (Math) → Teacher". Never students' answers.
  summary    String   @default("")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([programId, createdAt])
}

model ClassGroup {
  id            String             @id @default(cuid())
  classId       String
  class         Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  name          String
  createdAt     DateTime           @default(now())
  members       ClassGroupMember[]
  announcements Announcement[]

  @@index([classId])
}

model ClassGroupMember {
  groupId String
  group   ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Class {
  id                String             @id @default(cuid())
  programId         String
  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  staff             ClassStaff[]
  staffInvites      StaffInvite[]
  groups            ClassGroup[]
  sessions          ClassSession[]
  alertStates       AlertState[]
  /// Weekly progress emails to guardians who agreed to receive them.
  guardianSummaries Boolean            @default(false)
  curricula         Curriculum[]
  summaries         AssistantSummary[]
  draftLessons      DraftLesson[]
  threads           MessageThread[]
  announcements     Announcement[]
  teacherId         String
  teacher           User               @relation("teacher", fields: [teacherId], references: [id], onDelete: Cascade)
  name              String
  joinCode          String             @unique
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  members           ClassMember[]
  invites           ClassInvite[]
  courses           ClassCourse[]
  assignments       Assignment[]

  @@index([teacherId])
  @@index([programId])
}

model ClassMember {
  id       String   @id @default(cuid())
  classId  String
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([classId, userId])
  @@index([userId])
}

model ClassInvite {
  id            String    @id @default(cuid())
  classId       String
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  email         String
  createdAt     DateTime  @default(now())
  /// From a roster import: applied when the student joins.
  groupName     String?
  targetScore   Int?
  baselineTotal Int?
  baselineOn    DateTime?
  name          String?

  @@unique([classId, email])
}

/// A teacher's course shared with a class. Its files are copied to classes/<id>/ so
/// students' copies keep working even if the teacher changes or deletes the course.
model ClassCourse {
  id             String       @id @default(cuid())
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  sourceCourseId String?
  sourceCourse   Course?      @relation("classSource", fields: [sourceCourseId], references: [id], onDelete: SetNull)
  title          String
  /// The snapshot, taken when a student first opens the course (null until then).
  fileKey        String?
  coverKey       String?
  figuresPrefix  String?
  /// The teacher's file the snapshot was taken from (a new snapshot is taken if it changes, e.g. slides added).
  snapshotOf     String?
  createdAt      DateTime     @default(now())
  copies         Course[]     @relation("classCopies")
  assignments    Assignment[]

  @@unique([classId, sourceCourseId])
}

enum AssignmentKind {
  LESSONS // lessons from a course (or the whole course)
  QUESTIONS // questions from a worksheet the teacher uploaded
  EXTERNAL
  DIAGNOSTIC
}

model Assignment {
  id                 String              @id @default(cuid())
  classId            String
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  kind               AssignmentKind      @default(LESSONS)
  /// The course it's for: LESSONS come from it; QUESTIONS are filed under it (optional).
  classCourseId      String?
  classCourse        ClassCourse?        @relation(fields: [classCourseId], references: [id], onDelete: SetNull)
  title              String
  note               String?
  /// LESSONS: the teacher's lesson ids; empty means the whole course.
  lessonIds          String[]
  /// QUESTIONS: the worksheet and which of its questions, in order.
  worksheetId        String?
  worksheet          Worksheet?          @relation(fields: [worksheetId], references: [id], onDelete: SetNull)
  itemIds            String[]
  /// Optional time limit for a question set, like a timed practice section.
  timeLimitMin       Int?
  /// Subject it covers (SAT: MATH or RW) and its domains; staff scopes filter on these. Null = untagged.
  section            String?
  domains            String[]
  dueAt              DateTime?
  createdAt          DateTime            @default(now())
  answers            AssignmentAnswer[]
  starts             AssignmentStart[]
  /// EXTERNAL: College Board questions by link only: [{ key, questionId, url, section, domain }]. Never content.
  externalItems      Json                @default("[]")
  externalResults    ExternalResult[]
  /// DIAGNOSTIC: which diagnostic, and when it can be taken.
  diagnosticId       String?
  diagnostic         Diagnostic?         @relation(fields: [diagnosticId], references: [id], onDelete: Restrict)
  opensAt            DateTime?
  closesAt           DateTime?
  /// Who it's for: empty lists mean the whole class; otherwise these groups and/or students.
  groupIds           String[]
  studentIds         String[]
  diagnosticAttempts DiagnosticAttempt[]
  retakes            DiagnosticRetake[]

  @@index([classId, dueAt])
}

enum WorksheetStatus {
  UPLOADING
  READING
  READY
  FAILED
}

/// A PDF of questions a teacher uploaded (a worksheet, problem set, practice test).
/// Claude reads it and lists its questions; the teacher reviews them and makes assignments.
model Worksheet {
  id           String          @id @default(cuid())
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  fileKey      String
  sizeBytes    BigInt
  pageCount    Int?
  status       WorksheetStatus @default(UPLOADING)
  error        String?
  /// Claude found answers in the PDF (an answer key, or worked solutions).
  hasAnswerKey Boolean         @default(false)
  /// UPLOAD (a teacher's PDF) or AI_DRAFT (questions Claude drafted, waiting for review).
  source       String          @default("UPLOAD")
  createdAt    DateTime        @default(now())
  items        WorksheetItem[]
  assignments  Assignment[]

  @@index([ownerId, createdAt])
}

model WorksheetItem {
  id             String                 @id @default(cuid())
  worksheetId    String
  worksheet      Worksheet              @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  order          Int
  /// The number printed on the worksheet ("3", "4b").
  label          String
  type           QuestionType
  prompt         String
  choices        String[]
  correctChoice  Int?
  answer         String
  explanation    String
  steps          String[]
  pageRefs       Int[]
  /// Skill or topic, for the score report by skill.
  topic          String
  /// Where the answer came from: WORKSHEET (its answer key), CLAUDE (worked out; check it) or TEACHER.
  answerSource   String                 @default("WORKSHEET")
  /// SAT tags (src/lib/sat/domains.ts): suggested by Claude, confirmed by staff.
  section        String?
  domain         String?
  skill          String?
  difficulty     String?
  desmosSolvable Boolean                @default(false)
  tagsConfirmed  Boolean                @default(false)
  /// Bumped each time the question or its answer is edited after students answered it.
  version        Int                    @default(1)
  /// Removed from the worksheet after students had answered it: kept so past answers and grades stay.
  archivedAt     DateTime?
  /// AI-drafted questions can't be assigned until a staff member approves them.
  approvedById   String?
  approvedAt     DateTime?
  versions       WorksheetItemVersion[]
  answers        AssignmentAnswer[]

  @@index([worksheetId, order])
}

/// A student's answer to a worksheet question in an assignment. The latest one counts.
model AssignmentAnswer {
  id           String        @id @default(cuid())
  assignmentId String
  assignment   Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  itemId       String
  item         WorksheetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice       Int?
  response     String?
  correct      Boolean
  score        Float
  verdict      String
  feedback     String        @default("")
  gradedBy     String
  /// A teacher or specialist confirmed or overrode Claude's grade.
  reviewedById String?
  reviewedAt   DateTime?
  /// Claude's score before an override.
  aiScore      Float?
  /// The version of the question this answered (editing a question never changes past grades).
  itemVersion  Int           @default(1)
  createdAt    DateTime      @default(now())

  @@index([assignmentId, userId])
  @@index([itemId])
}

/// When a student started (and handed in) a question set; timed sets use it for the clock.
model AssignmentStart {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt    DateTime   @default(now())
  submittedAt  DateTime?

  @@unique([assignmentId, userId])
}

/// Better Auth's two-factor secrets (encrypted) and backup codes.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("twoFactor")
}

/// An earlier version of a worksheet question, kept when it's edited after students answered it.
model WorksheetItemVersion {
  id            String        @id @default(cuid())
  itemId        String
  item          WorksheetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  version       Int
  type          QuestionType
  prompt        String
  choices       String[]
  correctChoice Int?
  answer        String
  explanation   String
  steps         String[]
  editedById    String?
  createdAt     DateTime      @default(now())

  @@unique([itemId, version])
}

enum ScoreSource {
  DIAGNOSTIC
  PSAT
  SAT
  PRACTICE_BLUEBOOK
  PRACTICE_OTHER
}

/// An SAT score: official, practice or our diagnostic. Totals, section scores and missed question numbers only.
model ScoreRecord {
  id           String      @id @default(cuid())
  studentId    String
  student      User        @relation("scores", fields: [studentId], references: [id], onDelete: Cascade)
  source       ScoreSource
  takenOn      DateTime
  testName     String?
  total        Int
  rw           Int?
  math         Int?
  /// The score gains are measured from (one per student).
  isBaseline   Boolean     @default(false)
  /// Missed questions on an outside test: [{ section, module, number, domain, skill?, reason? }]. No content.
  missed       Json        @default("[]")
  enteredById  String
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([studentId, takenOn])
}

/// A student's own SAT settings.
model StudentProfile {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetScore     Int?
  testDate        DateTime?
  /// No score yet: they chose to take the diagnostic first.
  baselinePending Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
}

/// A student's result on a College Board question they opened by link (the latest counts).
model ExternalResult {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey      String
  result       String
  reason       String?
  timeSec      Int?
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, userId, itemKey])
}

enum DiagnosticStatus {
  DRAFT
  PUBLISHED
}

/// An adaptive SAT-style diagnostic: per section, module 1 then a harder or easier module 2.
model Diagnostic {
  id          String             @id @default(cuid())
  programId   String
  program     Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdById String
  title       String
  status      DiagnosticStatus   @default(DRAFT)
  /// Highest estimated section score on each route, e.g. { "hardMax": 800, "easyMax": 640 }. An estimate, never official.
  conversion  Json               @default("{\"hardMax\": 800, \"easyMax\": 640}")
  createdAt   DateTime           @default(now())
  modules     DiagnosticModule[]
  assignments Assignment[]
}

/// One timed module. stage: M1, M2_HARD or M2_EASY. Questions are worksheet questions with confirmed tags.
model DiagnosticModule {
  id             String     @id @default(cuid())
  diagnosticId   String
  diagnostic     Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  section        String
  stage          String
  timeLimitSec   Int
  itemIds        String[]
  /// Module 1 correct answers needed for the harder module 2.
  routeThreshold Int        @default(0)

  @@unique([diagnosticId, section, stage])
}

/// One student's sitting of a diagnostic. The clock is kept here, on the server.
model DiagnosticAttempt {
  id              String             @id @default(cuid())
  assignmentId    String
  assignment      Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNo       Int                @default(1)
  /// The modules in the order taken (module ids), filled in as the route is chosen.
  path            String[]
  currentModuleId String?
  moduleStartedAt DateTime?
  startedAt       DateTime           @default(now())
  finishedAt      DateTime?
  /// { sections: [{ section, route, correct, total, estimate }], total } once finished.
  results         Json?
  answers         DiagnosticAnswer[]

  @@unique([assignmentId, userId, attemptNo])
}

model DiagnosticAnswer {
  id          String            @id @default(cuid())
  attemptId   String
  attempt     DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  moduleId    String
  itemId      String
  itemVersion Int               @default(1)
  choice      Int?
  response    String?
  correct     Boolean
  timeMs      Int               @default(0)
  usedDesmos  Boolean           @default(false)
  updatedAt   DateTime          @updatedAt

  @@unique([attemptId, itemId])
}

/// A teacher allowed a student one more attempt.
model DiagnosticRetake {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  grantedById  String
  createdAt    DateTime   @default(now())

  @@index([assignmentId, userId])
}

/// The mistake log: every wrong answer comes back on a schedule until it's right twice in a row.
model MistakeItem {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// ASSIGNMENT, DIAGNOSTIC, EXTERNAL (College Board link) or SCORE (a miss on an outside test).
  sourceType  String
  sourceId    String
  /// The question to practise again (a worksheet question), if there is one.
  itemId      String?
  /// For College Board misses: the question to retry there.
  externalUrl String?
  externalId  String?
  section     String?
  domain      String?
  skill       String?
  reason      String?
  label       String
  due         DateTime
  streak      Int       @default(0)
  reviews     Int       @default(0)
  retiredAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([studentId, sourceType, sourceId])
  @@index([studentId, retiredAt, due])
}

/// A tutoring session (one-off or one of a weekly series), for attendance.
model ClassSession {
  id          String             @id @default(cuid())
  classId     String
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  groupId     String?
  title       String?
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdAt   DateTime           @default(now())
  attendance  AttendanceRecord[]

  @@index([classId, startsAt])
}

/// PRESENT, LATE, ABSENT or EXCUSED.
model AttendanceRecord {
  sessionId  String
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     String
  markedById String
  markedAt   DateTime     @default(now())

  @@id([sessionId, studentId])
  @@index([studentId])
}

/// A dismissed or snoozed alert (alerts themselves are worked out fresh each time).
model AlertState {
  id            String    @id @default(cuid())
  classId       String
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId     String
  kind          String
  dismissedById String
  /// Hidden until this time; null = dismissed until the situation changes (a new alert of this kind).
  until         DateTime?
  createdAt     DateTime  @default(now())

  @@unique([classId, studentId, kind])
}

/// A parent or guardian who agreed to a weekly progress email.
model GuardianContact {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  email          String
  relationship   String    @default("")
  /// When and by whom consent was recorded (required to send anything).
  consentAt      DateTime
  consentById    String
  unsubscribedAt DateTime?
  unsubToken     String    @unique
  lastSentOn     String?
  createdAt      DateTime  @default(now())

  @@unique([studentId, email])
}

/// Keys of scheduled emails already sent (e.g. "digest:<user>:<day>"), so each goes once.
model SentNotice {
  key       String   @id
  createdAt DateTime @default(now())
}

/// A class's curriculum: units mapped onto the school calendar. DRAFT until a teacher publishes it.
model Curriculum {
  id          String           @id @default(cuid())
  classId     String
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  sourceText  String           @default("")
  status      String           @default("DRAFT")
  createdById String
  createdAt   DateTime         @default(now())
  units       CurriculumUnit[]
}

model CurriculumUnit {
  id                 String     @id @default(cuid())
  curriculumId       String
  curriculum         Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  order              Int
  title              String
  domains            String[]
  skills             String[]
  startsOn           DateTime
  endsOn             DateTime
  notes              String     @default("")
  linkedCourseIds    String[]
  linkedWorksheetIds String[]

  @@index([curriculumId, order])
}

/// A short lesson Claude drafted; students see it only after a staff member approves it.
model DraftLesson {
  id           String    @id @default(cuid())
  classId      String
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  title        String
  domain       String?
  skill        String?
  content      String
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

/// The assistant's weekly summary for a class or one of its groups (staff only).
model AssistantSummary {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  groupId     String?
  weekOf      String
  content     Json
  model       String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([classId, groupId, weekOf])
}

/// A server or browser error, grouped by fingerprint. Messages are scrubbed of emails and long numbers; paths have no query string.
model ErrorEvent {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  kind        String
  message     String
  path        String
  digest      String?
  count       Int       @default(1)
  firstAt     DateTime  @default(now())
  lastAt      DateTime  @default(now())
  alertedAt   DateTime?
  resolvedAt  DateTime?
}

/// "Report a problem": the page, the browser and recent error ids. No form contents.
model ProblemReport {
  id         String    @id @default(cuid())
  userId     String?
  path       String
  userAgent  String
  errorIds   String[]
  note       String    @default("")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

/// A conversation between one staff member and one student about one class.
/// Who may start or read one is decided in src/server/messages.ts from the
/// staff member's current scope; the program admin can read every thread.
model MessageThread {
  id            String       @id @default(cuid())
  classId       String
  class         Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId     String
  student       User         @relation("threadStudent", fields: [studentId], references: [id], onDelete: Cascade)
  staffId       String
  staff         User         @relation("threadStaff", fields: [staffId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  lastMessageAt DateTime     @default(now())
  messages      Message[]
  reads         ThreadRead[]

  @@unique([classId, studentId, staffId])
  @@index([staffId, lastMessageAt])
  @@index([studentId, lastMessageAt])
  @@index([classId, lastMessageAt])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  /// Set when the message went to several students at once.
  bulkId    String?
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

model ThreadRead {
  threadId   String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime

  @@id([threadId, userId])
  @@index([userId])
}

/// A post to a whole class or one of its groups, shown on students' Today page.
model Announcement {
  id        String      @id @default(cuid())
  classId   String
  class     Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  groupId   String?
  group     ClassGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title     String
  body      String
  pinned    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([classId, createdAt])
}

/// The notification center. One row per thing to look at; a new message in
/// the same thread updates its row (same key) instead of adding another.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// MESSAGE, ANNOUNCEMENT, ALERT or REVIEW
  kind      String
  key       String
  title     String
  href      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readAt    DateTime?

  @@unique([userId, key])
  @@index([userId, readAt, updatedAt])
}

/// A badge a student earned. No leaderboards: badges are only ever shown to the
/// student and to staff whose scope includes them.
model Badge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// STREAK_5, STREAK_10, STREAK_30, MISTAKES_CLEARED, DOMAIN_MASTERED, FIRST_DIAGNOSTIC, GAIN_100, GAIN_200, PERFECT_ATTENDANCE
  kind     String
  /// The domain or month, for kinds that can be earned more than once.
  detail   String   @default("")
  earnedAt DateTime @default(now())

  @@unique([userId, kind, detail])
  @@index([userId, earnedAt])
}
