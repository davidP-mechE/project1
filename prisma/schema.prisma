// Coursebook database schema.
// Phase 1: accounts (Better Auth tables), books and courses.
// Phase 2: extracted pages, figures, text chunks, units/lessons (outline), jobs.
// Phase 3: lesson skip flag, course settings, detected outline.
// Phase 4: generated lesson content, questions, flashcards, API usage.
// Phase 5: lesson progress (completion) and practice question attempts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts (shape required by Better Auth) ────────────────────────────

enum Role {
  USER
  ADMIN
}

// Plan only gates usage limits. Payments (Stripe) come later and will just set this.
enum Plan {
  FREE
  PRO
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role     Role   @default(USER)
  plan     Plan   @default(FREE)
  timezone String @default("UTC")

  sessions Session[]
  accounts Account[]
  books    Book[]
  courses  Course[]

  lessonProgress   LessonProgress[]
  questionAttempts QuestionAttempt[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // scrypt hash, never the plain password
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Books (the uploaded PDF files) ─────────────────────────────────────

enum BookStatus {
  AWAITING_UPLOAD // record created, browser is uploading the file
  UPLOADED // file stored and validated, waiting for processing
  PROCESSING
  READY
  FAILED
}

model Book {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename  String
  storageKey        String     @unique
  sizeBytes         BigInt
  pageCount         Int?
  coverKey          String?
  status            BookStatus @default(AWAITING_UPLOAD)
  error             String?
  rightsConfirmed   Boolean    @default(false)
  // Set by processing: did the PDF have built-in bookmarks?
  hasBuiltInOutline Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  course  Course?
  pages   Page[]
  figures Figure[]
  chunks  Chunk[]
  jobs    Job[]

  @@index([userId, createdAt])
}

// ─── Courses (one per book) ──────────────────────────────────────────────

enum CourseStatus {
  UPLOADING
  PROCESSING // extracting text / OCR / outline (Phase 2)
  OUTLINE_DRAFT // student reviews the outline (Phase 3)
  GENERATING // lessons being written (Phase 4)
  ACTIVE
  FAILED
}

model Course {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String         @unique
  book            Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title           String
  status          CourseStatus   @default(UPLOADING)
  archivedAt      DateTime?
  lastOpenedAt    DateTime?
  // Cached completion percentage (0-100), recomputed when lesson progress changes.
  progressPct     Int            @default(0)
  // Where the outline came from: the PDF's bookmarks, detected headings, or fixed page ranges.
  outlineSource   OutlineSource?
  // The outline exactly as processing detected it, so the student can reset their edits.
  detectedOutline Json?
  // Level, explanation style, content types… (validated by src/lib/course/settings.ts)
  settings        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  units      Unit[]
  lessons    Lesson[]
  jobs       Job[]
  questions  Question[]
  flashcards Flashcard[]

  lessonProgress   LessonProgress[]
  questionAttempts QuestionAttempt[]

  @@index([userId, archivedAt])
}

enum OutlineSource {
  BOOKMARKS
  HEADINGS
  PAGE_RANGES
}

// ─── Extracted content (Phase 2) ─────────────────────────────────────────

enum TextSource {
  NATIVE // text layer inside the PDF
  OCR // recognised from a rendered image of the page
  NONE // no usable text (blank page, or OCR found nothing)
}

model Page {
  id                String     @id @default(cuid())
  bookId            String
  book              Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber        Int // physical page, 1-based (what the PDF viewer shows)
  label             String? // printed page number if the PDF defines one, e.g. "xii" or "47"
  text              String
  charCount         Int
  textSource        TextSource @default(NATIVE)
  ocrConfidence     Float? // 0-100, only for OCR pages
  // 0-1: how equation-heavy the page looks. High scores get flagged before lesson generation.
  mathScore         Float      @default(0)
  imageCount        Int        @default(0)
  isFrontBackMatter Boolean    @default(false)
  // Text lines with font sizes, kept so the outline can be re-detected without re-reading the PDF.
  lines             Json?
  // Equation-heavy pages re-read from an image by Claude, with math as LaTeX (Phase 4).
  repairedText      String?
  repairedAt        DateTime?
  width             Float
  height            Float

  @@unique([bookId, pageNumber])
}

model Figure {
  id         String @id @default(cuid())
  bookId     String
  book       Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber Int
  index      Int // order on the page
  storageKey String
  width      Int
  height     Int

  @@unique([bookId, pageNumber, index])
}

// Passages of ~400 tokens used for search and the tutor (embeddings added in Phase 7).
model Chunk {
  id         String @id @default(cuid())
  bookId     String
  book       Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ordinal    Int
  pageStart  Int
  pageEnd    Int
  text       String
  tokenCount Int

  @@unique([bookId, ordinal])
  @@index([bookId, pageStart])
}

// ─── Course structure (outline) ─────────────────────────────────────────

model Unit {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  isFrontBackMatter Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId, order])
}

enum LessonStatus {
  PENDING
  QUEUED
  GENERATING
  READY
  FLAGGED
  FAILED
}

model Lesson {
  id                String       @id @default(cuid())
  unitId            String
  unit              Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  pageStart         Int
  pageEnd           Int
  isFrontBackMatter Boolean      @default(false)
  // Student's choice to leave this lesson out of the course (starts as true for front/back matter).
  skip              Boolean      @default(false)
  status            LessonStatus @default(PENDING)
  // Generated content: objectives, explanation, worked examples, key terms (see src/lib/ai/lesson-schema.ts).
  content           Json?
  // Hash of everything that went into generating it (source text, settings, prompt, model).
  // If nothing changed, the lesson isn't regenerated.
  cacheKey          String?
  model             String?
  promptVersion     String?
  generatedAt       DateTime?
  userEdited        Boolean      @default(false)
  // Why the lesson was flagged instead of generated, or why generation failed.
  flagReason        String?
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  questions  Question[]
  flashcards Flashcard[]
  progress   LessonProgress[]
  attempts   QuestionAttempt[]

  @@index([unitId, order])
  @@index([courseId])
}

enum QuestionScope {
  LESSON
  UNIT_TEST
  FINAL_EXAM
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  STEP_BY_STEP
}

model Question {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  scope         QuestionScope @default(LESSON)
  type          QuestionType
  order         Int
  prompt        String
  choices       String[] // multiple choice only
  correctChoice Int? // index into choices
  answer        String // the correct answer, in words
  explanation   String
  steps         String[] // step-by-step solution (step-by-step problems)
  pageRefs      Int[]
  topic         String // short topic label, used later for "weak topics"
  userEdited    Boolean       @default(false)
  createdAt     DateTime      @default(now())

  attempts QuestionAttempt[]

  @@index([lessonId, order])
  @@index([courseId])
}

model Flashcard {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order      Int
  front      String
  back       String
  pageRefs   Int[]
  userEdited Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([lessonId, order])
  @@index([courseId])
}

// ─── Studying (Phase 5) ──────────────────────────────────────────────────

/** One row per student per lesson they've opened. */
model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  // The student marked this lesson "I found this confusing" (used for weak topics in Phase 8).
  confusing    Boolean   @default(false)
  lastViewedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

enum AttemptVerdict {
  CORRECT
  PARTIAL
  INCORRECT
}

enum GradedBy {
  LOCAL // multiple choice, or an exact/numeric match checked without Claude
  CLAUDE
  DEMO // FAKE_CLAUDE mode: a rough word-overlap check, clearly labelled
}

/**
 * Every answer a student submits to a practice question.
 * If the question is later regenerated, the attempt is kept (questionId becomes
 * null) with a copy of its topic, so the history still counts for weak topics.
 */
model QuestionAttempt {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questionId String?
  question   Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  topic      String
  choice     Int? // multiple choice: the option picked
  response   String // short answer / step-by-step: what the student wrote
  verdict    AttemptVerdict
  correct    Boolean
  score      Float // 0-1
  feedback   String
  gradedBy   GradedBy
  model      String?
  createdAt  DateTime       @default(now())

  @@index([questionId, userId, createdAt])
  @@index([userId, createdAt])
  @@index([courseId, userId])
}

// ─── Claude API usage (for cost tracking and limits) ─────────────────────

enum UsageFeature {
  LESSON
  QUESTIONS
  PAGE_REPAIR
  GRADING
  TUTOR
}

model UsageEvent {
  id               String       @id @default(cuid())
  userId           String
  courseId         String?
  lessonId         String?
  feature          UsageFeature
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  costMicroUsd     Int // millionths of a dollar
  createdAt        DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([courseId])
}

// ─── Background jobs ─────────────────────────────────────────────────────
// Mirrors each queue job so the app can show live status and the admin page can list failures.

enum JobType {
  PROCESS_BOOK
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  type        JobType
  status      JobStatus @default(QUEUED)
  bookId      String?
  book        Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  step        String? // machine-readable current step, e.g. "ocr"
  progress    Int       @default(0) // 0-100
  message     String? // shown to the student, e.g. "OCR on page 112 of 340…"
  error       String? // friendly error shown to the student
  errorDetail String? // technical detail for the admin page
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([bookId, createdAt])
  @@index([status, createdAt])
}
