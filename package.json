{
  "name": "coursebook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-pdfjs.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/copy-pdfjs.mjs",
    "worker": "tsx --env-file-if-exists=.env --conditions=react-server src/worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env --conditions=react-server src/worker/index.ts",
    "fixtures": "node tests/fixtures/generate.mjs",
    "smoke:claude": "tsx --env-file-if-exists=.env scripts/smoke-claude.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@huggingface/transformers": "4.3.0",
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-auth": "^1.7.18",
    "bullmq": "^6.7.2",
    "ioredis": "^6.0.0",
    "katex": "^0.19.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.4.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
